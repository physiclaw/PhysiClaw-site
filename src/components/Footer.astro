<footer class="relative border-t border-border-subtle">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-5">
      <div class="flex items-center gap-2.5 text-text-secondary text-sm">
        <img src="/favicon.svg" alt="" class="w-5 h-5" />
        <span class="font-display font-bold text-text">PhysiClaw</span>
        <span class="text-text-tertiary">·</span>
        <span class="text-text-tertiary">&copy; 2026 · MIT License</span>
      </div>
      <div class="flex items-center gap-5 text-sm text-text-tertiary">
        <a href="/vision" class="hover:text-text transition-colors"><T en="Vision" zh="愿景" /></a>
        <a href="https://docs.physiclaw.ai" class="hover:text-text transition-colors"><T en="Docs" zh="文档" /></a>
        <a href="https://github.com/physiclaw/PhysiClaw" target="_blank" rel="noopener" aria-label="GitHub" class="inline-flex items-center hover:text-text transition-colors">
          <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24"><path d={githubIconPath}/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
