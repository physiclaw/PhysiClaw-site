---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page not found · PhysiClaw">
  <section class="relative overflow-hidden min-h-screen flex items-center">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="glow w-[460px] h-[460px] -top-20 left-1/2 -translate-x-1/2" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-lg px-6 py-24 text-center">
      <img src="/crab.svg" alt="PhysiClaw crab mascot" class="w-28 h-28 mx-auto mb-8 animate-float drop-shadow-[0_24px_60px_rgba(241,95,46,0.28)]" />

      <p class="font-mono text-[11px] tracking-[0.25em] uppercase text-text-tertiary mb-4">
        <span class="text-accent">//</span> error 404
      </p>

      <h1 class="font-display text-5xl sm:text-6xl font-extrabold tracking-tight leading-none mb-5">
        <span class="text-gradient">Page not found</span>
      </h1>

      <p class="text-[15px] sm:text-base text-text-secondary mb-9 leading-[1.7]">
        That page doesn't exist. Even a robotic finger can't tap what isn't there.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="group inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-accent text-white font-medium text-sm hover:bg-accent-dim transition-all shadow-[0_14px_40px_-12px_var(--color-accent)] hover:-translate-y-0.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
          Back home
        </a>
        <a href="https://docs.physiclaw.ai" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-border bg-bg-elevated/40 text-text-secondary hover:text-text hover:border-accent/40 font-medium text-sm transition-all hover:-translate-y-0.5">
          Read the docs
          <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H9M17 7v8"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
