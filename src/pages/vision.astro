    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    font-size: 1.6rem;
    line-height: 1.15;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    scroll-margin-top: 5rem;
  }
  .prose h2::before {
    content: "";
    display: block;
    width: 2.25rem;
    height: 3px;
    border-radius: 9999px;
    background: var(--color-accent);
    margin-bottom: 1.1rem;
    opacity: 0.9;
  }
  /* First heading in each language block shouldn't add the large top gap */
  .prose > div > h2:first-child { margin-top: 0; }
  .prose p {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.85;
    margin-bottom: 1.25rem;
    max-width: 42rem;
  }
  .prose p:last-child {
    margin-bottom: 0;
  }
  .prose strong {
    color: var(--color-text);
    font-weight: 600;
  }
  @media (min-width: 640px) {
    .prose h2 { font-size: 1.875rem; margin-top: 4rem; }
    .prose p { font-size: 1.125rem; }
  }
</style>
